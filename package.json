{
  "name": "agentceo-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --port 5179",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "WRANGLER_SEND_METRICS=false wrangler dev --port 8787 --local",
    "db:local": "WRANGLER_SEND_METRICS=false wrangler d1 migrations apply agentceo-waitlist --local",
    "test": "vitest run",
    "evals:chat": "node scripts/chat-evals.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "prebuild": "node scripts/build-knowledge.mjs && node scripts/build-rest-css.mjs && node emails/scripts/worker-templates.mjs",
    "pretest": "node scripts/build-knowledge.mjs && node scripts/build-rest-css.mjs && node emails/scripts/worker-templates.mjs",
    "deploy": "npm run build && WRANGLER_SEND_METRICS=false wrangler deploy"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.0",
    "astro": "^7.4.1",
    "lucide-preact": "^1.60.0",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "lighthouse": "^13.5.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "vitest": "^4.1.12",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.151.2"
  },
  "workspaces": [
    "emails"
  ]
}
