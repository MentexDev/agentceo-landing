---
import LegalView from '../../views/LegalView.astro'
import { legalDocs } from '../../lib/legal.js'
export function getStaticPaths() {
  return legalDocs().filter((d) => d.lang === 'es').map((doc) => ({ params: { doc: doc.slug }, props: { doc } }))
}
const { doc } = Astro.props
---
<LegalView doc={doc} />
