---
import ArticleView from '../../views/ArticleView.astro'
import { section } from '../../lib/content.js'
export function getStaticPaths() {
  return section('blog', 'es').ITEMS.map((item) => ({ params: { slug: item.slug }, props: { item } }))
}
const { item } = Astro.props
---
<ArticleView kind="blog" lang="es" item={item} />
