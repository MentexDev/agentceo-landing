---
import ArticleView from '../../../views/ArticleView.astro'
import { section } from '../../../lib/content.js'
export function getStaticPaths() {
  return section('noticias', 'en').ITEMS.map((item) => ({ params: { slug: item.slug }, props: { item } }))
}
const { item } = Astro.props
---
<ArticleView kind="noticias" lang="en" item={item} />
