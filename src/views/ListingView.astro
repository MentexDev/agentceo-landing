---
// Listado de una sección de contenido (noticias / blog / recursos): destacada, filtros por
// categoría (botones con aria-pressed; sin JS se ven todas) y rejilla de tarjetas.
import Base from '../layouts/Base.astro'
import PageHead from '../components/page/PageHead.astro'
import Card from '../components/page/Card.astro'
import '../styles/pages.css'
import { t } from '../i18n/config.js'
import { href, alternatesFor } from '../i18n/rutas.js'
import { section, itemUrl } from '../lib/content.js'
import { breadcrumbs, ORIGIN } from '../lib/jsonld.js'
interface Props { kind: 'noticias' | 'blog' | 'recursos'; lang: string }
const { kind, lang } = Astro.props
const s = section(kind, lang)!
const featured = s.ITEMS.find((i) => i.featured) || s.ITEMS[0]
const rest = s.ITEMS.filter((i) => i !== featured)
const path = href(kind, lang)
const crumbs = [{ name: t(lang, 'pages.breadcrumbHome'), url: href('home', lang) }, { name: s.META.eyebrow, url: path }]
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: s.META.title, description: s.META.sub, url: `${ORIGIN}${path}`, inLanguage: lang,
      mainEntity: { '@type': 'ItemList', itemListElement: s.ITEMS.map((it, i) => ({ '@type': 'ListItem', position: i + 1, url: `${ORIGIN}${itemUrl(kind, lang, it.slug)}`, name: it.title })) } },
    breadcrumbs(crumbs),
  ],
}
---
<Base lang={lang} title={s.META.title} description={s.META.sub} path={path} alternates={alternatesFor(kind)} active={kind} page={kind} jsonLd={jsonLd}>
  <div class="pg"><div class="pg-wrap lst">
    <PageHead crumbs={crumbs} eyebrow={s.META.eyebrow} h1a={s.META.h1} sub={s.META.sub} />
    <!-- Filtros SIN JS: radios con estilo de chip + :has(). No aparecen tarde (CLS 0,062 medido
         cuando los revelaba el JS), funcionan sin JavaScript y son un grupo de radio nativo. -->
    <fieldset class="chips filt" data-filters>
      <legend class="sr-only">{t(lang, 'pages.filterBy')}</legend>
      {['all', ...s.CATEGORIES].map((c, i) => (
        <label class="chip"><input type="radio" name="cat" value={c} checked={i === 0} /><span>{c === 'all' ? t(lang, 'pages.all') : c}</span></label>
      ))}
    </fieldset>
    {featured && <Card item={featured} url={itemUrl(kind, lang, featured.slug)} lang={lang} featured />}
    <div class="cgrid">
      {rest.map((it) => <Card item={it} url={itemUrl(kind, lang, it.slug)} lang={lang} headingLevel={2} />)}
    </div>
    <p class="empty" data-empty>{t(lang, 'pages.empty')}</p>
  </div></div>
</Base>
<style set:html={[
  // Una regla por categoría: oculta lo que no es de la categoría marcada…
  ...s.CATEGORIES.map((c) => `.lst:has(input[value="${c.replace(/"/g, '')}"]:checked) [data-cat]:not([data-cat="${c.replace(/"/g, '')}"]){display:none}`),
  // …y muestra el aviso de vacío solo si esa categoría no tiene piezas.
  ...s.CATEGORIES.filter((c) => !s.ITEMS.some((i) => i.category === c)).map((c) => `.lst:has(input[value="${c.replace(/"/g, '')}"]:checked) [data-empty]{display:block}`),
].join('')} />
