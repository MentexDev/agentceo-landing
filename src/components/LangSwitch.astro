---
// Selector de idioma. Es un <details> (funciona sin JS y es un disclosure accesible);
// con JS se cierra con Escape y al hacer clic fuera. Muestra cada idioma en SU idioma
// y lleva a la página EQUIVALENTE. Si la página no existe en ese idioma, va a su
// portada (y lo avisa en el title del enlace). Recuerda la elección en la cookie
// funcional `lang` (no requiere consentimiento: es una preferencia pedida por el usuario).
import { LOCALES, LOCALE_META, t } from '../i18n/config.js'
import { href } from '../i18n/rutas.js'
interface Props { lang: string; alternates: { lang: string; url: string }[]; tone?: 'light' | 'dark' }
const { lang, alternates, tone = 'light' } = Astro.props
const items = LOCALES.map((l) => {
  const alt = alternates.find((a) => a.lang === l)
  return {
    l,
    meta: LOCALE_META[l],
    url: alt ? alt.url : href('home', l),
    translated: Boolean(alt),
    current: l === lang,
  }
})
const cur = LOCALE_META[lang]
---
<details class:list={['lang', `lang-${tone}`]} data-lang-switch>
  <summary aria-label={`${t(lang, 'lang.switchTo')} · ${t(lang, 'a11y.langCurrent', { name: cur.name })}`}>
    <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.6 2.8 3.9 5.8 3.9 9s-1.3 6.2-3.9 9c-2.6-2.8-3.9-5.8-3.9-9S9.4 5.8 12 3z"></path>
    </svg>
    <span class="lang-cur" aria-hidden="true">{cur.short}</span>
    <svg class="lang-caret" aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m6 9 6 6 6-6"></path></svg>
  </summary>
  <ul class="lang-list" role="list">
    {items.map((it) => (
      <li>
        <a
          href={it.url}
          hreflang={it.meta.bcp47}
          lang={it.meta.bcp47}
          aria-current={it.current ? 'true' : undefined}
          data-set-lang={it.l}
          title={it.translated ? undefined : t(lang, 'lang.notTranslated', { name: it.meta.name })}
        >
          <span class="lang-name">{it.meta.name}</span>
          <span class="lang-code" aria-hidden="true">{it.meta.short}</span>
          {it.current && <svg class="lang-check" aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>}
        </a>
      </li>
    ))}
  </ul>
</details>

<style>
  .lang { position: relative; }
  .lang summary {
    list-style: none; display: inline-flex; align-items: center; gap: 6px;
    min-height: 44px; min-width: 44px; padding: 0 12px; border-radius: var(--radius-pill);
    cursor: pointer; font-size: 14px; font-weight: 500; user-select: none;
    transition: background-color .2s;
  }
  .lang summary::-webkit-details-marker { display: none; }
  .lang-light summary:hover { background: rgba(17, 17, 19, .06); }
  .lang-dark summary:hover { background: rgba(244, 242, 237, .1); }
  .lang-caret { transition: transform .25s var(--ease-out); }
  .lang[open] .lang-caret { transform: rotate(180deg); }
  .lang-list {
    position: absolute; right: 0; top: calc(100% + 8px); z-index: 60;
    min-width: 190px; margin: 0; padding: 6px; list-style: none;
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--line); border-radius: 16px;
    box-shadow: 0 18px 40px -12px rgba(17, 17, 19, .28), 0 2px 6px rgba(17, 17, 19, .06);
    transform-origin: top right;
    animation: langIn .22s var(--ease-spring);
  }
  .lang-dark .lang-list { bottom: calc(100% + 8px); top: auto; transform-origin: bottom right; }
  @keyframes langIn { from { opacity: 0; transform: translateY(-4px) scale(.96); } }
  .lang-list a {
    display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 12px;
    border-radius: 10px; text-decoration: none; color: var(--ink); font-size: 15px;
  }
  .lang-list a:hover, .lang-list a:focus-visible { background: var(--gold-3); color: var(--ink); }
  .lang-list a[aria-current='true'] { font-weight: 600; }
  .lang-name { flex: 1; }
  .lang-code { font-family: var(--mono); font-size: 11.5px; color: var(--muted); letter-spacing: .06em; }
  .lang-check { color: var(--gold-ink); }
</style>

<script>
  // Cierra con Escape (devolviendo el foco) y al hacer clic fuera; guarda la preferencia.
  for (const d of document.querySelectorAll<HTMLDetailsElement>('[data-lang-switch]')) {
    const sum = d.querySelector('summary')!
    d.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && d.open) { d.open = false; sum.focus() }
    })
    document.addEventListener('click', (e) => { if (d.open && !d.contains(e.target as Node)) d.open = false })
    for (const a of d.querySelectorAll<HTMLAnchorElement>('[data-set-lang]')) {
      a.addEventListener('click', () => {
        const secure = location.protocol === 'https:' ? '; Secure' : ''
        document.cookie = `lang=${a.dataset.setLang}; Path=/; Max-Age=31536000; SameSite=Lax${secure}`
      })
    }
  }
</script>
