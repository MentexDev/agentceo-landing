---
// Compartir (portado de la v1, a3421c2): Facebook y X abren su sharer oficial; Instagram y
// TikTok no aceptan compartir un enlace desde la web, así que usan el menú nativo
// (navigator.share) en móvil o copian el enlace en escritorio.
import { t } from '../../i18n/config.js'
interface Props { lang: string }
const { lang } = Astro.props
const nets = [
  ['facebook', 'Facebook', '<path fill="currentColor" d="M15 8.5h-2a.9.9 0 00-1 .9V11h3l-.4 3H12v7H9v-7H7v-3h2V9a3.5 3.5 0 013.5-3.5H15v3z"/>'],
  ['x', 'X', '<path fill="currentColor" d="M17.5 3H21l-7.2 8.2L22 21h-6.6l-4.3-5.6L6 21H2.5l7.7-8.8L2 3h6.8l3.9 5.1L17.5 3zm-1.2 16h1.9L7.8 4.9H5.8L16.3 19z"/>'],
  ['instagram', 'Instagram', '<rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>'],
  ['tiktok', 'TikTok', '<path fill="currentColor" d="M16.5 3c.35 2.1 1.6 3.55 3.5 3.85v3c-1.4 0-2.75-.42-3.9-1.18v6.15a5.4 5.4 0 11-5.4-5.4c.3 0 .6.02.9.07v3.1a2.3 2.3 0 101.6 2.18V3h3.3z"/>'],
  ['copy', null, '<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M10 13a5 5 0 007 0l2-2a5 5 0 00-7-7l-1 1M14 11a5 5 0 00-7 0l-2 2a5 5 0 007 7l1-1"/>'],
]
const msgs = { copied: t(lang, 'pages.copied'), copiedFor: t(lang, 'pages.copiedFor', { net: '{net}' }), manual: t(lang, 'pages.copyManual', { url: '{url}' }) }
---
<div class="share" data-share-box data-msgs={JSON.stringify(msgs)}>
  <span class="share-label">{t(lang, 'pages.share')}</span>
  {nets.map(([net, label, svg]) => (
    <button class="share-btn" type="button" data-share={net} aria-label={label ? t(lang, 'pages.shareOn', { net: label }) : t(lang, 'pages.copyLink')}>
      <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" set:html={svg} />
    </button>
  ))}
  <span class="share-msg" role="status" aria-live="polite"></span>
</div>
<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-share-box]')) {
    const M = JSON.parse(box.dataset.msgs!)
    const url = () => location.href.split('#')[0]
    const say = (m: string) => { const s = box.querySelector('.share-msg')!; s.textContent = m; setTimeout(() => { s.textContent = '' }, 3500) }
    const copy = (net: string | null) => {
      const u = url()
      const done = () => say(net ? M.copiedFor.replace('{net}', net) : M.copied)
      if (navigator.clipboard) navigator.clipboard.writeText(u).then(done, () => say(M.manual.replace('{url}', u)))
      else say(M.manual.replace('{url}', u))
    }
    box.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-share]')
      if (!b) return
      const n = b.dataset.share, u = encodeURIComponent(url()), tx = encodeURIComponent(document.title)
      const win = (h: string) => window.open(h, '_blank', 'noopener,noreferrer,width=600,height=540')
      if (n === 'facebook') win(`https://www.facebook.com/sharer/sharer.php?u=${u}`)
      else if (n === 'x') win(`https://twitter.com/intent/tweet?url=${u}&text=${tx}`)
      else if (n === 'instagram' || n === 'tiktok') {
        if (navigator.share) navigator.share({ title: document.title, url: url() }).catch(() => {})
        else copy(n === 'instagram' ? 'Instagram' : 'TikTok')
      } else copy(null)
    })
  }
</script>
