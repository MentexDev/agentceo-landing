---
// Logo «agent.ceo» con la mascota (del prototipo, S01/S20).
import Mascot from './Mascot.astro'
interface Props { variant?: 'dark' | 'light'; size?: number; text?: number }
const { variant = 'dark', size = 34, text = 19 } = Astro.props
---
<span class="logo">
  <Mascot size={size} variant={variant} />
  <span class="logo-word" style={`font-size:${text}px`}>agent<span class="logo-dot">.</span>ceo</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo-word { font-weight: 600; letter-spacing: -0.02em; line-height: 1; }
  /* El punto es decorativo: el texto accesible es «agent.ceo» igual. */
  .logo-dot { color: var(--gold); }
</style>
