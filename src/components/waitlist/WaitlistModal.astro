---
// MODAL de la lista de espera (S21 del prototipo, en 3 pasos: correo → tipo de negocio → dentro).
// Es un <dialog> nativo: trampa de foco, Escape, fondo inerte y vuelta del foco al botón que lo
// abrió, sin código propio (el prototipo no tenía nada de esto). El paso 2 es OPCIONAL: el correo
// ya quedó guardado en el paso 1, así que pedir de más nunca cuesta un lead.
import Mascot from '../Mascot.astro'
import WaitlistForm from './WaitlistForm.astro'
import orbitMini from './orbit-mini.html?raw'
import { t } from '../../i18n/config.js'
import { BUSINESS_TYPES } from '../../data/waitlist.js'
interface Props { lang: string }
const { lang } = Astro.props
const tr = (k: string) => t(lang, k)
const check = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#111113" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>'
const confetti = Array.from({ length: 15 }, (_, i) => ({ a: `${i * 24}deg`, c: ['#D9B866', '#111113', '#B8923A'][i % 3] }))
---
<dialog class="jm" id="wl-modal" aria-labelledby="wl-modal-title" data-wl-modal data-step="form">
  <div class="jcard">
    <button type="button" class="jclose" data-wl-close aria-label={tr('wl.modal.close')}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>

    <div class="jside on-dark" aria-hidden="true">
      <span class="jbadge">{tr('wl.modal.badge')}</span>
      <div class="jmasc"><Mascot size={170} variant="light" tie eye={3.6} blink="4.6s" blinkDelay="0s" /></div>
      <div class="orbit-mini" set:html={orbitMini}></div>
    </div>

    <div class="jbody">
      <!-- PASO 1 · correo -->
      <section class="jstep" data-step-panel="form">
        <h2 id="wl-modal-title" class="jh">
          <span data-copy="default">{tr('wl.modal.h2a')}<em>{tr('wl.modal.h2b')}</em></span>
          <span data-copy="exit" hidden>{tr('wl.modal.exitA')}<em>{tr('wl.modal.exitB')}</em></span>
        </h2>
        <p class="jp">
          <span data-copy="default">{tr('wl.modal.p')}</span>
          <span data-copy="exit" hidden>{tr('wl.modal.exitP')}</span>
        </p>
        <ul class="jlist" role="list">
          {['b1', 'b2', 'b3'].map((b) => <li><span class="jdot" set:html={check}></span>{tr(`wl.modal.${b}`)}</li>)}
        </ul>
        <WaitlistForm lang={lang} source="modal" id="wl-modal-form" layout="stack" submitLabel={tr('wl.modal.cta')} busyLabel={tr('wl.modal.ctaBusy')} note={tr('wl.modal.nospam')} />
      </section>

      <!-- PASO 2 · tipo de negocio (opcional) -->
      <section class="jstep" data-step-panel="biz" hidden>
        <span class="jstepnum"><span class="jdot" set:html={check}></span>{tr('wl.modal.step2')}</span>
        <h2 class="jh" tabindex="-1" data-step-focus>{tr('wl.modal.h2bizA')}<em>{tr('wl.modal.h2bizB')}</em></h2>
        <p class="jp">{tr('wl.modal.pBiz')}</p>
        <form class="jbiz" data-wl-biz novalidate>
          <fieldset>
            <legend class="sr-only">{tr('wl.modal.bizLegend')}</legend>
            <div class="jchips">
              {BUSINESS_TYPES.map((b) => (
                <label class="jchip">
                  <input type="radio" name="business" value={b} />
                  <span>{tr(`wl.modal.biz.${b}`)}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <p class="wl-msg jbiz-msg" role="alert" data-wl-biz-msg></p>
          <button class="jcta" type="submit" data-label={tr('wl.modal.save')} data-busy={tr('wl.busy')}>
            <span class="wl-spin" aria-hidden="true"></span><span class="wl-btn-txt">{tr('wl.modal.save')}</span>
          </button>
          <button class="jskip" type="button" data-wl-skip>{tr('wl.modal.skip')}</button>
        </form>
      </section>

      <!-- PASO 3 · dentro -->
      <section class="jstep jdone" data-step-panel="done" hidden>
        <div class="confetti" aria-hidden="true">
          {confetti.map((c) => <span class="cf" style={`--a:${c.a};--c:${c.c}`}></span>)}
        </div>
        <div class="jumpy"><Mascot size={84} tie eye={3} blink="3.8s" /></div>
        <h2 class="jh" tabindex="-1" data-step-focus>{tr('wl.modal.doneA')}<em class="gold">{tr('wl.modal.doneB')}</em></h2>
        <div class="jmail" data-wl-mail hidden>✉ <span data-wl-mail-text></span></div>
        <p class="jp" role="status">{tr('wl.modal.doneP')}</p>
        <button type="button" class="jghost" data-wl-close>{tr('wl.modal.keep')}</button>
      </section>
    </div>
  </div>
</dialog>

<style>
  .jm {
    width: min(900px, calc(100% - 32px)); max-width: none; max-height: calc(100dvh - 32px);
    padding: 0; border: 0; background: transparent; overflow: visible; color: var(--ink);
  }
  .jm::backdrop { background: rgba(17, 17, 19, .55); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .jm[open] { animation: jin .55s var(--ease-spring) both; }
  .jm[open]::backdrop { animation: jfade .3s ease both; }
  @keyframes jin { from { opacity: 0; transform: translateY(30px) scale(.94); } to { opacity: 1; transform: none; } }
  @keyframes jfade { from { opacity: 0; } to { opacity: 1; } }
  :global(html:has(.jm[open])) { overflow: hidden; }

  .jcard {
    position: relative; display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    max-height: calc(100dvh - 32px); overflow-y: auto; overscroll-behavior: contain;
    border-radius: 30px; background: var(--cream); border: 1.5px solid var(--ink); box-shadow: 12px 12px 0 var(--gold);
  }
  .jclose {
    position: absolute; top: 14px; right: 14px; z-index: 3; width: 44px; height: 44px; border-radius: 50%;
    display: grid; place-items: center; border: 1.5px solid var(--ink); background: var(--cream); color: var(--ink); cursor: pointer;
    transition: transform .25s var(--ease-spring), background-color .2s;
  }
  .jclose:hover { transform: rotate(90deg); background: #fff; }
  .jside { position: relative; background: var(--ink); display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: 32px; overflow: hidden; }
  .jbadge { align-self: flex-start; padding: 4px 10px; border-radius: var(--radius-pill); background: var(--gold-2); color: var(--ink); font-family: var(--mono); font-size: 11px; letter-spacing: .14em; }
  .jmasc { align-self: center; }
  .jmasc :global(.body) { animation: hello 2.8s ease-in-out infinite; }
  @keyframes hello { 0%, 60%, 100% { transform: rotate(0); } 70% { transform: rotate(-8deg); } 80% { transform: rotate(6deg); } 90% { transform: rotate(-3deg); } }
  .orbit-mini { display: flex; justify-content: center; gap: 10px; }
  .orbit-mini :global(svg) { overflow: visible; }

  .jbody { padding: 44px 40px; display: flex; flex-direction: column; gap: 18px; }
  .jstep { display: flex; flex-direction: column; gap: 18px; animation: jpop .55s var(--ease-spring) both; }
  .jstep[hidden] { display: none; }
  @keyframes jpop { from { opacity: 0; transform: scale(.92); } to { opacity: 1; transform: none; } }
  .jh { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(32px, 4vw, 44px); line-height: 1.02; letter-spacing: -.02em; outline: none; }
  .jh em { font-style: italic; }
  .jh em.gold { color: var(--gold-ink); }
  .jp { margin: 0; font-size: 16px; line-height: 1.55; color: var(--muted); }
  .jlist { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .jlist li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; line-height: 1.45; }
  .jdot { margin-top: 2px; flex: none; width: 20px; height: 20px; border-radius: 50%; background: var(--gold-2); display: grid; place-items: center; }
  .jstepnum { display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 11px; letter-spacing: .16em; color: var(--gold-ink); }
  .jstepnum .jdot { width: 18px; height: 18px; margin: 0; }

  .jbiz { display: grid; gap: 14px; }
  .jbiz fieldset { margin: 0; padding: 0; border: 0; }
  .jchips { display: flex; flex-wrap: wrap; gap: 8px; }
  .jchip { position: relative; }
  .jchip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .jchip span {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: var(--radius-pill);
    border: 1.5px solid var(--ink); font-size: 14px; cursor: pointer; transition: background-color .2s, color .2s, transform .2s var(--ease-spring);
  }
  .jchip:hover span { background: var(--gold-3); }
  .jchip input:checked + span { background: var(--ink); color: var(--cream); transform: scale(1.03); }
  .jchip input:focus-visible + span { outline: 2px solid var(--gold-ink); outline-offset: 3px; }
  .jcta {
    display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; border-radius: 16px; border: 0;
    background: var(--ink); color: var(--cream); font-size: 17px; font-weight: 600; cursor: pointer;
  }
  .jbiz[aria-busy='true'] .wl-spin { display: inline-block; }
  .jbiz .wl-spin { display: none; width: 16px; height: 16px; border-radius: 50%; border: 2px solid rgba(244, 242, 237, .35); border-top-color: var(--cream); animation: wlspin2 .7s linear infinite; }
  @keyframes wlspin2 { to { transform: rotate(360deg); } }
  .jbiz-msg { margin: 0; font-size: 13px; color: var(--danger); }
  .jbiz-msg:empty { display: none; }
  .jskip { justify-self: center; min-height: 44px; padding: 0 12px; border: 0; background: none; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; font-size: 14px; }
  .jskip:hover { color: var(--ink); }

  .jdone { position: relative; align-items: flex-start; }
  .confetti { position: absolute; left: 40px; top: 30px; pointer-events: none; }
  .confetti .cf { position: absolute; width: 8px; height: 12px; border-radius: 2px; background: var(--c); animation: cf 1.1s var(--ease-out) forwards; }
  @keyframes cf { 0% { transform: rotate(var(--a)) translateY(0) scale(.4); opacity: 1; } 100% { transform: rotate(var(--a)) translateY(-70px) rotate(180deg) scale(1); opacity: 0; } }
  .jumpy :global(.body) { animation: jump .7s var(--ease-spring); }
  .jmail { display: flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: var(--radius-pill); background: var(--gold-3); font-size: 13px; max-width: 100%; overflow-wrap: anywhere; }
  .jmail[hidden] { display: none; }
  .jghost { min-height: 48px; padding: 0 22px; border-radius: var(--radius-pill); border: 1.5px solid var(--ink); background: transparent; color: var(--ink); font-size: 15px; cursor: pointer; }
  .jghost:hover { background: rgba(17, 17, 19, .06); }

  @media (max-width: 760px) {
    .jm { width: 100%; max-height: 100dvh; margin: auto 0 0; }
    .jm[open] { animation: jsheet .45s var(--ease-out) both; }
    @keyframes jsheet { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
    .jcard { grid-template-columns: 1fr; border-radius: 26px 26px 0 0; box-shadow: none; border-width: 1.5px 0 0; max-height: 92dvh; }
    .jside { flex-direction: row; align-items: center; padding: 18px 20px; }
    .jmasc, .orbit-mini { display: none; }
    .jbody { padding: 24px 20px calc(24px + env(safe-area-inset-bottom)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .confetti { display: none; }
  }
</style>
