---
// La mascota CEO del prototipo, como COMPONENTE (en el prototipo se repetía el
// SVG entero en cada sección). Variante `dark` = cuerpo negro (sobre crema);
// `light` = cuerpo crema (sobre negro). Ojos que siguen al puntero: data-eye
// (los anima src/scripts/vida.js). Decorativa por defecto (aria-hidden).
interface Props {
  size?: number
  variant?: 'dark' | 'light'
  eye?: number
  blink?: string
  blinkDelay?: string
  tie?: boolean
  label?: string
  class?: string
}
const { size = 34, variant = 'dark', eye = 2.6, blink = '5.2s', blinkDelay = '-1s', tie = false, label, class: cls = '' } = Astro.props
const body = variant === 'dark' ? '#111113' : '#F4F2ED'
const face = variant === 'dark' ? '#F4F2ED' : '#111113'
const h = tie ? Math.round(size * 1.18) : size
const vb = tie ? '0 0 100 118' : '0 0 100 100'
---
<svg
  class:list={['mascot', cls]}
  width={size}
  height={h}
  viewBox={vb}
  {...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' })}
  focusable="false"
>
  <g class="body">
    <g data-tilt="">
      <line x1="50" y1="19" x2="50" y2="7" stroke={body} stroke-width="3" stroke-linecap="round"></line>
      <circle class="ant" cx="50" cy="6" r="4.5" fill="#B8923A"></circle>
      <rect x="12" y="18" width="76" height="70" rx="26" fill={body}></rect>
      <g class="eyes" style={`--bl:${blink};--bd:${blinkDelay}`}>
        <g class="eyeopen">
          <ellipse data-eye={eye} cx="38" cy="51" rx="8.5" ry="10.5" fill={face}></ellipse>
          <circle class="pupil" cx="38" cy="52" r="4.4" fill={body}></circle>
          <ellipse data-eye={eye} cx="62" cy="51" rx="8.5" ry="10.5" fill={face}></ellipse>
          <circle class="pupil" cx="62" cy="52" r="4.4" fill={body}></circle>
        </g>
        <g class="eyearc">
          <path d="M30 53q8-9 16 0" stroke={face} stroke-width="3.6" fill="none" stroke-linecap="round"></path>
          <path d="M54 53q8-9 16 0" stroke={face} stroke-width="3.6" fill="none" stroke-linecap="round"></path>
        </g>
      </g>
      <path class="mouth" d="M44 69q6 5 12 0" stroke={face} stroke-width="3" fill="none" stroke-linecap="round"></path>
      <circle class="blush" cx="27" cy="64" r="4" fill="#B8923A"></circle>
      <circle class="blush" cx="73" cy="64" r="4" fill="#B8923A"></circle>
    </g>
    {tie && (
      <g class="tie">
        <path d="M45 87h10l-2 5h-6z" fill="#7A5C17"></path>
        <path d="M47 92h6l5 15-8 8-8-8z" fill="#B8923A"></path>
      </g>
    )}
  </g>
</svg>
