{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentceo-landing",
  "compatibility_date": "2026-05-04",
  "assets": {
    "directory": "./public"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "agentceo.io", "custom_domain": true },
    { "pattern": "www.agentceo.io", "custom_domain": true }
  ]
}
