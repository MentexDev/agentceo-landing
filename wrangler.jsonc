{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentceo-landing",
  "compatibility_date": "2026-05-04",
  "main": "worker/index.js",
  // El sitio estático lo genera Astro en ./dist (npm run build).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "agentceo.io", "custom_domain": true },
    { "pattern": "www.agentceo.io", "custom_domain": true }
  ],
  // Rate limiting nativo de Workers (ventana de 60 s por clave = IP + ruta).
  // Cierra la deuda MED de la auditoría del 2026-08-10 (endpoints sin límite de tasa).
  "ratelimits": [
    { "name": "RL_FORMS", "namespace_id": "7001", "simple": { "limit": 8, "period": 60 } },
    { "name": "RL_CHAT", "namespace_id": "7002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Widget de soporte · T33 (Luca, 20-oct): LIVE POR DEFECTO vía OpenRouter. El secreto
  // OPENROUTER_API_KEY ya existe en producción (`wrangler secret put OPENROUTER_API_KEY`; nunca
  // aquí ni en el repo): al desplegar, el modelo queda encendido. En local no hay clave → stub.
  // Topes (worker/chat/channels/index.js y docs/DUDAS.md, «T33 · chat»): $5/día global con
  // reserva atómica previa, respuestas live por IP (10/día sin Turnstile, 25 con él), mensajes
  // por IP y por sesión (ráfaga/hora/día), 500 caracteres, 12 turnos, 400 tokens de salida,
  // historial al modelo ≤ 4.000 caracteres, timeout 15 s. Cualquier fallo → stub.
  // CHAT_MODEL solo admite modelos con precio en worker/chat/live.js (PRICES); otro → stub.
  // Turnstile (gratis) · T58: protege la LISTA DE ESPERA (token obligatorio antes de guardar y de
  // mandar la bienvenida) y el chat (cupo live por IP de 25 en vez de 10, y persona verificada).
  //   1. ✅ Widget creado (Managed; agentceo.io y www.agentceo.io) y su SITE KEY ya está abajo.
  //   2. Activar = poner el secreto: `wrangler secret put TURNSTILE_SECRET_KEY` (nunca aquí ni en el
  //      repo). Comando exacto, sin que el secreto pase por la pantalla: docs/TURNSTILE.md.
  //   Apagar = `wrangler secret delete TURNSTILE_SECRET_KEY` (al instante, sin deploy).
  // Sin las DOS, todo sigue como antes: ni widget, ni token exigido, ni challenges.cloudflare.com en la CSP.
  "vars": {
    "CHAT_MODE": "live",
    "CHAT_MODEL": "google/gemini-2.5-flash-lite",
    "CHAT_DAILY_BUDGET_USD": "5",
    // T58b: tope GLOBAL de respuestas live del chat por día UTC (todas las IP). Al llegar, mensaje fijo
    // que remite a info@agentceo.io, sin llamar al modelo. Contador en el DO ChatGuard («budget»).
    "CHAT_DAILY_GLOBAL_CAP": "2000",
    // Bienvenida por correo a la lista de espera (T57 · docs/EMAILS-ENVIO.md). ENCENDIDA el 2026-10-22 (T57b, OK de Diego) tras aplicar
    // la migración 0003 en producción y Diego/Luca la enciendan ("true"). Usa el secreto RESEND_API_KEY.
    "WELCOME_EMAIL_ENABLED": "true",
    // Pública: widget «agentceo.io · lista de espera y chat» (Managed; agentceo.io y www), creado el 22-oct
    // con `wrangler turnstile widget create` (T58). SIN el secreto TURNSTILE_SECRET_KEY no activa nada.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFhJ06Nhr0kRGswq"
  },
  // Barrido de correos pendientes (reintentos con backoff y bienvenidas que esperaban al paso 2 del modal).
  // Cron Triggers son gratis en el plan Free; con el flag apagado, el barrido no toca nada.
  "triggers": { "crons": ["*/2 * * * *"] },
  // Topes diarios del widget (por IP con hash, y gasto global del modo live).
  "durable_objects": {
    "bindings": [{ "name": "CHAT_GUARD", "class_name": "ChatGuard" }]
  },
  "migrations": [{ "tag": "v1-chat-guard", "new_sqlite_classes": ["ChatGuard"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentceo-waitlist",
      "database_id": "06f5dc3a-1355-4518-b5c0-665a9809fba5",
      // ⛔ Las migraciones se aplican en local (npm run db:local). En producción las aplica Diego.
      "migrations_dir": "migrations"
    }
  ]
}
